+RECEIPT_PREFIX = "Reserved "
+
+
+def format_line(sku: str, quantity: int) -> str:
+    return f"{quantity} x {sku}"
+
+
+def format_reference(reference: str) -> str:
+    return f"({reference})"
+
+
+def format_receipt(sku: str, quantity: int, reference: str) -> str:
+    line = format_line(sku, quantity)
+    suffix = format_reference(reference)
+    return RECEIPT_PREFIX + line + " " + suffix
