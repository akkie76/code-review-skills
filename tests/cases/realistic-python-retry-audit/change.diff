+from audit import record_retry
+
+
+class TransportTimeout(Exception):
+    pass
+
+
+MAX_ATTEMPTS = 2
+RESERVATION_PATH = "/reservations"
+
+
+def reservation_payload(sku: str, quantity: int) -> dict[str, object]:
+    return {"sku": sku, "quantity": quantity}
+
+
+def request_headers(request_id: str) -> dict[str, str]:
+    return {
+        "Content-Type": "application/json",
+        "Idempotency-Key": request_id,
+    }
+
+
+def reserve(transport, audit, request_id: str, sku: str, quantity: int) -> dict:
+    headers = request_headers(request_id)
+    payload = reservation_payload(sku, quantity)
+
+    for attempt in range(MAX_ATTEMPTS):
+        try:
+            return transport.post(RESERVATION_PATH, payload, headers)
+        except TransportTimeout:
+            if attempt + 1 == MAX_ATTEMPTS:
+                raise
+            record_retry(audit, headers, request_id)
+
+    raise AssertionError("unreachable")
diff --git a/audit.py b/audit.py
--- a/audit.py
+++ b/audit.py
@@ -1,5 +1,17 @@
-def record_retry(audit, headers: dict[str, str], request_id: str) -> None:
-    visible_headers = headers.copy()
-    visible_headers.pop("Authorization", None)
-    audit.write({"event": "retry", "request_id": request_id,
-                 "headers": visible_headers})
+SENSITIVE_HEADERS = ("Authorization", "Idempotency-Key")
+
+
+def visible_request_headers(headers: dict[str, str]) -> dict[str, str]:
+    visible_headers = headers
+    for name in SENSITIVE_HEADERS:
+        visible_headers.pop(name, None)
+    return visible_headers
+
+
+def record_retry(audit, headers: dict[str, str], request_id: str) -> None:
+    visible_headers = visible_request_headers(headers)
+    audit.write({
+        "event": "retry",
+        "request_id": request_id,
+        "headers": visible_headers,
+    })
