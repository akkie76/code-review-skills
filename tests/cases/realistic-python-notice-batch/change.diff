diff --git a/test_dispatcher.py b/test_dispatcher.py
new file mode 100644
index 0000000..cc27ac4
--- /dev/null
+++ b/test_dispatcher.py
@@ -0,0 +1,57 @@
+import unittest
+
+from audit import AuditLog
+from dispatcher import dispatch_pending
+from model import Notice
+from report import id_line, summary_line
+from sender import DeliveryError, Sender
+from store import NoticeStore
+from template import preview
+
+
+def notice(identifier: str, tenant_id: str = "north") -> Notice:
+    return Notice(
+        id=identifier,
+        tenant_id=tenant_id,
+        recipient="person@example.invalid",
+        subject="Notice " + identifier,
+        body="Ready",
+    )
+
+
+class DispatchTests(unittest.TestCase):
+    def test_one_page_and_other_tenant(self) -> None:
+        store = NoticeStore([notice("n1"), notice("n2"), notice("s1", "south")])
+        deliveries: list[tuple[str, str, str]] = []
+        sender = Sender(lambda recipient, subject, body: deliveries.append(
+            (recipient, subject, body)
+        ))
+        audit = AuditLog()
+
+        sent = dispatch_pending(store, sender, audit, "north")
+
+        self.assertEqual(sent, ["n1", "n2"])
+        self.assertEqual(len(deliveries), 2)
+        self.assertEqual([item.id for item in store.pending("south")], ["s1"])
+        self.assertEqual(store.pending_count("north"), 0)
+        self.assertEqual(store.sent_count("north"), 2)
+        self.assertEqual(audit.events[-1]["count"], "2")
+
+    def test_failed_delivery_stays_pending(self) -> None:
+        store = NoticeStore([notice("n1")])
+        sender = Sender(lambda *_: (_ for _ in ()).throw(DeliveryError()))
+
+        with self.assertRaises(DeliveryError):
+            dispatch_pending(store, sender, AuditLog(), "north")
+
+        self.assertEqual([item.id for item in store.pending("north")], ["n1"])
+
+    def test_display_refactors_preserve_output(self) -> None:
+        item = notice("n1")
+        self.assertEqual(preview(item), "Notice n1\nReady")
+        self.assertEqual(summary_line("north", ["n1"]), "north: sent 1 notice(s)")
+        self.assertEqual(id_line([]), "none")
+
+
+if __name__ == "__main__":
+    unittest.main()
