diff --git a/store.py b/store.py
index 95c22ff..2648631 100644
--- a/store.py
+++ b/store.py
@@ -14,5 +14,21 @@ class NoticeStore:
             key=lambda notice: notice.id,
         )
 
+    def pending_page(
+        self, tenant_id: str, offset: int, limit: int
+    ) -> list[Notice]:
+        if offset < 0 or limit < 1:
+            raise ValueError("invalid page bounds")
+        return self.pending(tenant_id)[offset:offset + limit]
+
+    def pending_count(self, tenant_id: str) -> int:
+        return len(self.pending(tenant_id))
+
+    def sent_count(self, tenant_id: str) -> int:
+        return sum(
+            1 for notice in self.notices.values()
+            if notice.tenant_id == tenant_id and notice.sent
+        )
+
     def mark_sent(self, notice_id: str) -> None:
         self.notices[notice_id].sent = True
