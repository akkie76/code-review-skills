--- a/dispatcher.py
+++ b/dispatcher.py
@@ -3,13 +3,24 @@ from sender import Sender
 from store import NoticeStore
 
 
+PAGE_SIZE = 2
+
+
 def dispatch_pending(
     store: NoticeStore, sender: Sender, audit: AuditLog, tenant_id: str
 ) -> list[str]:
     sent_ids: list[str] = []
-    for notice in store.pending(tenant_id):
-        sender.send(notice)
-        store.mark_sent(notice.id)
-        audit.sent(tenant_id, notice.id)
-        sent_ids.append(notice.id)
+    offset = 0
+    audit.started(tenant_id)
+    while True:
+        page = store.pending_page(tenant_id, offset, PAGE_SIZE)
+        if not page:
+            break
+        for notice in page:
+            sender.send(notice)
+            store.mark_sent(notice.id)
+            audit.sent(tenant_id, notice.id)
+            sent_ids.append(notice.id)
+        offset += len(page)
+    audit.completed(tenant_id, len(sent_ids))
     return sent_ids
